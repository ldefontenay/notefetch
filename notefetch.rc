// NoteFetch's resources, compiled into the exe by build.rs.
//
// THREE RULES FOR THE MAIN WINDOW. Breaking any of them breaks the reading
// for a screen reader user while looking perfectly fine on screen.
//
// 1. Every label comes immediately before the control it names. Windows
//    reads a static label as the name of the control that FOLLOWS it in this
//    file, and only looks backwards. Move a label after its control and the
//    control has no name at all.
// 2. Every Alt letter is unique across the controls AND the menu bar titles,
//    because both answer Alt+letter in the same window. In use:
//      Menu bar:  F File, R Recording, L Folder, A Actions, H Help
//      Controls:  S Show, E Folder, N Filter by name, C Recordings,
//                 Y Sync new, D Download selected, O Open output folder,
//                 G Log
// 3. Every label reads correctly on its own. A screen reader user hears one
//    control at a time; JAWS does not reliably announce group boxes, so there
//    are none.
//
// Tab order is the order of this file, and follows SPEC.md "Main window".

#include <windows.h>
#include <commctrl.h>

1 RT_MANIFEST "notefetch.manifest"

#define IDD_MAIN            100
#define IDR_MENU            200
#define IDR_ACCEL           201

#define IDC_SHOW           1001
#define IDC_FOLDER         1002
#define IDC_FILTER         1003
#define IDC_LIST           1004
#define IDC_SYNC           1005
#define IDC_DOWNLOAD       1006
#define IDC_OPEN_OUTPUT    1007
#define IDC_LOG            1008

#define IDM_EXIT           2001
#define IDM_SIGN_IN        2002
#define IDM_SIGN_OUT       2003
#define IDM_SETTINGS       2004
#define IDM_DOWNLOAD       2010
#define IDM_SELECT_ALL     2011
#define IDM_OPEN_RECORDING 2012
#define IDM_SYNC           2020
#define IDM_REFRESH        2021
#define IDM_CANCEL         2022
#define IDM_FIND           2023
#define IDM_OPEN_OUTPUT    2024
#define IDM_HELP           2031
#define IDM_ABOUT          2032
#define IDM_DEFAULT        2040
#define IDM_PLAY           2041
#define IDM_TRANSCRIPT     2042
#define IDM_SUMMARY        2043
#define IDM_COPY_PATH      2044
#define IDM_RENAME         2045
#define IDM_MOVE           2046
#define IDM_DELETE         2047
#define IDM_SKIP           2048
#define IDM_NEW_FOLDER     2060
#define IDM_RENAME_FOLDER  2061
#define IDM_DELETE_FOLDER  2062

#define IDD_MOVE            110
#define IDC_MOVE_LIST      1101
#define IDC_MOVE_NEW       1102
#define IDD_NAME            120
#define IDC_NAME_LABEL     1201
#define IDC_NAME_EDIT      1202
#define IDD_SETTINGS        130
#define IDC_SET_FOLDER     1301
#define IDC_SET_BROWSE     1302
#define IDC_SET_SYNC_START 1303
#define IDC_SET_SYNC_NEW   1304
#define IDC_SET_CONFIRM    1305
#define IDC_SET_DEL_SKIPS  1306
#define IDC_SET_AUDIO      1307
#define IDC_SET_TRANSCRIPT 1308
#define IDC_SET_SUMMARY    1309
#define IDC_SET_OTHER      1310
#define IDC_SET_TXT        1311
#define IDC_SET_DAYS       1312
#define IDC_SET_ANNOUNCE   1313
#define IDC_SET_LOG_FILE   1314
#define IDC_SET_ACCOUNT    1315
#define IDC_SET_SOUNDS     1316
#define IDC_SET_VOLUME     1317
#define IDD_ABOUT           150
#define IDC_ABOUT_TEXT     1501
#define IDD_FIRST           140
#define IDC_FIRST_INTRO    1401
#define IDC_FIRST_ALL      1402
#define IDC_FIRST_DAYS     1403
#define IDC_FIRST_NOW      1404
#define IDC_FIRST_N        1405

IDD_MAIN DIALOGEX 0, 0, 400, 292
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "NoteFetch"
MENU IDR_MENU
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT       "&Show:", -1, 7, 9, 26, 8
    COMBOBOX    IDC_SHOW, 36, 7, 120, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_GROUP | WS_TABSTOP

    LTEXT       "Fold&er:", -1, 170, 9, 28, 8
    COMBOBOX    IDC_FOLDER, 200, 7, 193, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_GROUP | WS_TABSTOP

    LTEXT       "Filter by &name:", -1, 7, 27, 56, 8
    EDITTEXT    IDC_FILTER, 66, 25, 327, 12, ES_AUTOHSCROLL | WS_GROUP | WS_TABSTOP

    LTEXT       "Re&cordings:", -1, 7, 44, 100, 8
    CONTROL     "", IDC_LIST, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | LVS_EDITLABELS | WS_BORDER | WS_GROUP | WS_TABSTOP, 7, 54, 386, 146

    PUSHBUTTON  "S&ync new", IDC_SYNC, 7, 205, 70, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON  "&Download selected", IDC_DOWNLOAD, 82, 205, 84, 14, WS_TABSTOP
    PUSHBUTTON  "&Open output folder", IDC_OPEN_OUTPUT, 171, 205, 84, 14, WS_TABSTOP

    LTEXT       "Lo&g:", -1, 7, 225, 100, 8
    EDITTEXT    IDC_LOG, 7, 235, 386, 50, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_GROUP | WS_TABSTOP
END

// About NoteFetch (Help menu). The text is a single-line read-only box,
// which a screen reader reads in full when it gets focus. Alt letter: D.
// OK has none: it is Enter, and Escape closes the window too.
IDD_ABOUT DIALOGEX 0, 0, 260, 52
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About NoteFetch"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Details:", -1, 7, 7, 246, 8
    EDITTEXT        IDC_ABOUT_TEXT, 7, 17, 246, 12, ES_AUTOHSCROLL | ES_READONLY | WS_GROUP | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 203, 33, 50, 14, WS_GROUP | WS_TABSTOP
END

// Move to folder (Ctrl+Shift+M). SPEC.md "Folders". Rules 1 and 3 above
// apply; Alt letters need only be unique within this window: F, N. OK and
// Cancel have none: they are Enter and Escape.
IDD_MOVE DIALOGEX 0, 0, 220, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Move to folder"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Folders:", -1, 7, 7, 206, 8
    LISTBOX         IDC_MOVE_LIST, 7, 17, 206, 76, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_GROUP | WS_TABSTOP
    LTEXT           "&New folder name (optional):", -1, 7, 99, 206, 8
    EDITTEXT        IDC_MOVE_NEW, 7, 109, 206, 12, ES_AUTOHSCROLL | WS_GROUP | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 109, 129, 50, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "Cancel", IDCANCEL, 163, 129, 50, 14, WS_TABSTOP
END

// One name: New folder and Rename folder. The caption is set when it opens.
// Alt letter: F.
IDD_NAME DIALOGEX 0, 0, 220, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Name"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Folder name:", IDC_NAME_LABEL, 7, 7, 206, 8
    EDITTEXT        IDC_NAME_EDIT, 7, 17, 206, 12, ES_AUTOHSCROLL | WS_GROUP | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 109, 41, 50, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "Cancel", IDCANCEL, 163, 41, 50, 14, WS_TABSTOP
END

// Settings (Ctrl+Comma). SPEC.md "Settings", in its order. Rules 1 and 3
// above apply. Alt letters, unique within this window: O B S N K L A T M R X
// D E P V W, and I or U on the account button, whose text says Sign in or Sign
// out. OK and Cancel have none: they are Enter and Escape. The output folder
// is a single-line read-only box, which a screen reader reads in full.
IDD_SETTINGS DIALOGEX 0, 0, 280, 330
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Output folder:", -1, 7, 7, 266, 8
    EDITTEXT        IDC_SET_FOLDER, 7, 17, 210, 12, ES_AUTOHSCROLL | ES_READONLY | WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "&Browse...", IDC_SET_BROWSE, 223, 16, 50, 14, WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX    "&Sync when NoteFetch starts", IDC_SET_SYNC_START, 7, 36, 266, 10, WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX    "Download &new recordings when syncing", IDC_SET_SYNC_NEW, 7, 50, 266, 10, WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX    "As&k before deleting", IDC_SET_CONFIRM, 7, 64, 266, 10, WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX    "De&lete marks a recording never downloaded as Don't download", IDC_SET_DEL_SKIPS, 7, 78, 266, 10, WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX    "Download &audio", IDC_SET_AUDIO, 7, 96, 266, 10, WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX    "Download &transcripts", IDC_SET_TRANSCRIPT, 7, 110, 266, 10, WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX    "Download su&mmaries", IDC_SET_SUMMARY, 7, 124, 266, 10, WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX    "Download othe&r parts: cleaned transcript, outline and highlights", IDC_SET_OTHER, 7, 138, 266, 10, WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX    "Save summaries as .t&xt files instead of .md", IDC_SET_TXT, 7, 152, 266, 10, WS_GROUP | WS_TABSTOP
    LTEXT           "&Days to keep checking for a transcript or summary Plaud has not made yet:", -1, 7, 170, 266, 8
    EDITTEXT        IDC_SET_DAYS, 7, 180, 40, 12, ES_NUMBER | ES_AUTOHSCROLL | WS_GROUP | WS_TABSTOP
    LTEXT           "Spoken announcem&ents:", -1, 7, 198, 266, 8
    COMBOBOX        IDC_SET_ANNOUNCE, 7, 208, 150, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX    "&Play sounds for what you do", IDC_SET_SOUNDS, 7, 228, 266, 10, WS_GROUP | WS_TABSTOP
    LTEXT           "Sound &volume:", -1, 7, 242, 266, 8
    COMBOBOX        IDC_SET_VOLUME, 7, 252, 150, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX    "Also &write the Log to the file notefetch.log", IDC_SET_LOG_FILE, 7, 272, 266, 10, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "Sign &in to Plaud", IDC_SET_ACCOUNT, 7, 288, 100, 14, WS_GROUP | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 169, 309, 50, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "Cancel", IDCANCEL, 223, 309, 50, 14, WS_TABSTOP
END

// The first-sync question. SPEC.md "Sync". The three choices are one group
// of radio buttons, moved through with the arrow keys; their text is set when
// it opens, to say how many recordings each means. The number of days comes
// after them, since a box between two radio buttons would split the group.
// Alt letters: E S N D.
IDD_FIRST DIALOGEX 0, 0, 260, 132
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "First sync"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_FIRST_INTRO, 7, 7, 246, 26
    AUTORADIOBUTTON "&Everything", IDC_FIRST_ALL, 7, 38, 246, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Specified duration", IDC_FIRST_DAYS, 7, 52, 246, 10
    AUTORADIOBUTTON "&Nothing old", IDC_FIRST_NOW, 7, 66, 246, 10
    LTEXT           "Specified duration, number of &days:", -1, 7, 84, 246, 8
    EDITTEXT        IDC_FIRST_N, 7, 94, 40, 12, ES_NUMBER | ES_AUTOHSCROLL | WS_GROUP | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 149, 112, 50, 14, WS_GROUP | WS_TABSTOP
    PUSHBUTTON      "Cancel", IDCANCEL, 203, 112, 50, 14, WS_TABSTOP
END

// Every command with its shortcut, so commands can be found without the help.
// The Recording menu holds the same commands as the context menu (SPEC.md);
// which are available, and which one Enter carries out, is set each time it
// opens, from the focused recording.
IDR_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "Sign &in to Plaud...", IDM_SIGN_IN
        MENUITEM "Sign &out of Plaud", IDM_SIGN_OUT
        MENUITEM SEPARATOR
        MENUITEM "&Settings...	Ctrl+Comma", IDM_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "E&xit	Alt+F4", IDM_EXIT
    END
    POPUP "&Recording"
    BEGIN
        MENUITEM "&Play", IDM_PLAY
        MENUITEM "Open &transcript	Ctrl+T", IDM_TRANSCRIPT
        MENUITEM "Open su&mmary	Ctrl+M", IDM_SUMMARY
        MENUITEM "Open the recording's &folder	Ctrl+Shift+O", IDM_OPEN_RECORDING
        MENUITEM "&Copy audio file path	Ctrl+Shift+C", IDM_COPY_PATH
        MENUITEM SEPARATOR
        MENUITEM "&Download selected	Ctrl+D", IDM_DOWNLOAD
        MENUITEM "Do&n't download", IDM_SKIP
        MENUITEM SEPARATOR
        MENUITEM "&Rename	F2", IDM_RENAME
        MENUITEM "Mo&ve to folder...	Ctrl+Shift+M", IDM_MOVE
        MENUITEM "D&elete	Delete", IDM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Select &all	Ctrl+A", IDM_SELECT_ALL
    END
    POPUP "Fo&lder"
    BEGIN
        MENUITEM "&New folder...", IDM_NEW_FOLDER
        MENUITEM "&Rename folder...", IDM_RENAME_FOLDER
        MENUITEM "&Delete folder...", IDM_DELETE_FOLDER
        MENUITEM SEPARATOR
        MENUITEM "&Open output folder	Ctrl+O", IDM_OPEN_OUTPUT
    END
    POPUP "&Actions"
    BEGIN
        MENUITEM "&Sync new	Ctrl+S", IDM_SYNC
        MENUITEM "&Refresh the list from Plaud	F5", IDM_REFRESH
        MENUITEM "&Cancel what is running	Escape", IDM_CANCEL
        MENUITEM SEPARATOR
        MENUITEM "Move to the &filter box	Ctrl+F", IDM_FIND
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "NoteFetch &guide	F1", IDM_HELP
        MENUITEM SEPARATOR
        MENUITEM "&About NoteFetch", IDM_ABOUT
    END
END

// Window-wide keys only. Keys that belong to the list (Enter, Delete, F2,
// Ctrl+A, Ctrl+D, Ctrl+T, Ctrl+M, Ctrl+Shift+C, Ctrl+Shift+M and
// Ctrl+Shift+O) are handled by the list itself, so they keep their usual
// meaning in the filter box.
IDR_ACCEL ACCELERATORS
BEGIN
    "S", IDM_SYNC, VIRTKEY, CONTROL
    VK_F5, IDM_REFRESH, VIRTKEY
    "F", IDM_FIND, VIRTKEY, CONTROL
    "O", IDM_OPEN_OUTPUT, VIRTKEY, CONTROL
    0xBC, IDM_SETTINGS, VIRTKEY, CONTROL    // VK_OEM_COMMA
    VK_F1, IDM_HELP, VIRTKEY
END

// Keep the numbers in step with the version in Cargo.toml.
VS_VERSION_INFO VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904B0"   // UK English, Unicode
        BEGIN
            VALUE "CompanyName",      "Laurent Cadet de Fontenay"
            VALUE "FileDescription",  "Download your Plaud recordings, transcripts and summaries"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "notefetch"
            VALUE "LegalCopyright",   "MIT licensed"
            VALUE "OriginalFilename", "notefetch.exe"
            VALUE "ProductName",      "NoteFetch"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
END
